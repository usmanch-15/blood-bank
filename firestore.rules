rules_version = '2';

// ============================================================================
// Smart Blood Bank — Firestore Security Rules
//
// v2 UPDATE: previously `match /users/{userId} { allow read: if isSignedIn(); }`
// let ANY signed-in user read another user's full profile — including their
// exact phoneNumber and latitude/longitude. Firestore security rules can only
// grant/deny access to a WHOLE document, not individual fields, so the only
// correct fix is to move the sensitive fields (phoneNumber, latitude,
// longitude, precise location) into a separate subcollection that only the
// owner and admin can read. The main /users/{userId} doc keeps only the
// fields needed for donor matching / display (name, role, status, bloodGroup,
// isDonor, isAvailable, rewardPoints, etc.) and stays readable to any
// signed-in user, same as before.
//
// ⚠️ THIS REQUIRES A MATCHING APP-CODE CHANGE — see the Copilot command
// provided alongside this file. Until the app writes phoneNumber/lat/lng to
// /users/{userId}/private/contact instead of the main user doc, those fields
// will simply stop being written/read (not a security hole, just broken
// donor-contact + geo features until the code catches up).
//
// ⚠️ STILL OUTSTANDING (found during Phase 3 wiring, not fixed here): the
// app code (auth_service.dart, donor_profile_screen.dart) currently still
// writes `phoneNumber` directly onto the top-level users/{userId} doc, so
// it IS still exposed to any signed-in user via `allow read: if isSignedIn()`
// below, despite this comment's original intent. That migration to the
// private subcollection was never actually done in app code — flagging so
// it isn't missed. Not addressed in this pass since it's a frontend change
// across several files.
//
// v3 UPDATE (Phase 3): added rules for 3 collections that Phase-3 frontend
// code already reads/writes but had no rules for: rate_limits, reports /
// misuse_reports, broadcasts.
//
// Deploy: firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin sirf Firestore mein role=='admin' AND status=='approved' user hai.
    function isAdmin() {
      return isSignedIn() &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // ─────────────────────────── USERS (public profile) ───────────────────────────
    match /users/{userId} {
      // ✅ Still readable by any signed-in user — but this document no
      // longer contains phoneNumber / latitude / longitude (see private
      // subcollection below). Only non-sensitive matching/display fields
      // live here: name, role, status, bloodGroup, isDonor, isReceiver,
      // isAvailable, rewardPoints, profileImageUrl, createdAt,
      // lastDonationDate, nextEligibleDate, city (general area only).
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
          && request.resource.data.status == 'pending'
          && request.resource.data.role in ['donor', 'receiver'];

      // User apna 'role', 'status', 'rewardPoints' khud nahi badal sakta —
      // sirf admin. Baaki profile info (naam, blood group, availability
      // toggle) khud update kar sakta hai.
      allow update: if isAdmin()
          || (
              isOwner(userId) &&
              request.resource.data.role == resource.data.role &&
              request.resource.data.status == resource.data.status &&
              request.resource.data.rewardPoints == resource.data.rewardPoints
          );

      allow delete: if isAdmin();

      // ─────────────── PRIVATE (phone + exact location) ───────────────
      // ✅ NEW: sirf owner aur admin padh/likh sakte hain. Koi doosra
      // signed-in user is subcollection ko bilkul nahi padh sakta — is
      // liye phone number aur exact GPS coordinates ab kisi aur ko nahi
      // dikhtay.
      match /private/{doc} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // ─────────────────────── BLOOD REQUESTS ───────────────────────
    match /blood_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
          && request.resource.data.requesterId == request.auth.uid;

      // ✅ FIX: requester (receiver) apni request update kar sakta hai
      // (jaise hospital name, notes waghera), LEKIN "status" field khud
      // nahi badal sakta — status sirf admin change kar sakta hai. Pehle
      // requester khud apni request ko "fulfilled" mark karke fake credit
      // le sakta tha.
      allow update: if isAdmin()
          || (
              isSignedIn() &&
              resource.data.requesterId == request.auth.uid &&
              request.resource.data.status == resource.data.status
          );

      allow delete: if isAdmin();
    }

    // ───────────────────────── DONATIONS ─────────────────────────
    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
          && request.resource.data.donorId == request.auth.uid;
      allow update: if isAdmin()
          || (
              isSignedIn() &&
              resource.data.donorId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['certificateUrl'])
          );
      allow delete: if isAdmin();
    }

    // ──────────────────────── NOTIFICATIONS ────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─────────────────────────── REWARDS ───────────────────────────
    match /rewards/{rewardId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ──────────────────────── SOS REQUESTS ────────────────────────
    match /sosRequests/{sosId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
          && request.resource.data.receiverId == request.auth.uid;
      // ✅ UPDATED: notifyNearbyDonorsOnSOS (Cloud Function, Admin SDK —
      // bypasses these rules entirely) now also updates `status` to
      // 'rate_limited'. Client-side update rule is unchanged: owner/admin
      // can still update their own SOS (e.g. mark resolved).
      allow update: if isAdmin()
          || (isSignedIn() && resource.data.receiverId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ──────────────────────── BLOOD DRIVES ────────────────────────
    match /blood_drives/{driveId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ──────────────────────── AUDIT LOGS ────────────────────────
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ──────────────────────── RATE LIMITS ──────────────────────── [NEW]
    // Written/read ONLY by rateLimiter.js via the Admin SDK, which bypasses
    // these rules entirely — so this collection should never need a client
    // write path. Admin can read for debugging/support; nobody else can
    // read or write it directly (a user could otherwise clear their own
    // rate-limit doc to bypass SOS spam prevention).
    match /rate_limits/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ──────────────────────── REPORTS (misuse) ──────────────────── [NEW]
    // ⚠️ Two different collections exist in the app code right now:
    //   - `reports`         — written by report_service.dart (ReportService),
    //                          which is what report_misuse_button.dart
    //                          actually calls. Field: reportedBy.
    //   - `misuse_reports`  — read by admin_web_reports.dart (the admin
    //                          queue). Field: reporterId.
    // These are NOT the same collection, so reports submitted by users
    // via the report button currently never reach the admin queue — a
    // real bug, flagged separately, not fixed in this pass (frontend fix
    // needed: point ReportService at `misuse_reports` with matching field
    // names). Rules for both are added here so neither is left insecure
    // in the meantime.
    match /reports/{reportId} {
      allow read: if isAdmin()
          || (isSignedIn() && resource.data.reportedBy == request.auth.uid);
      allow create: if isSignedIn()
          && request.resource.data.reportedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /misuse_reports/{reportId} {
      allow read: if isAdmin()
          || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isSignedIn()
          && request.resource.data.reporterId == request.auth.uid;
      // Admin reviews/updates status, adminNotes, adminReviewedBy, resolvedAt
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ──────────────────────── BROADCASTS ──────────────────────────── [NEW]
    // Only admin creates broadcasts (AdminBroadcastScreen). The
    // onBroadcastCreated Cloud Function (Admin SDK, bypasses rules) is the
    // only thing that ever updates status/sentAt/sentCount afterwards, so
    // client-side update is intentionally not allowed to anyone, including
    // admin — this keeps the "status: sent" + counts trustworthy as a
    // server-computed record rather than something an admin client could
    // fake.
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
          && request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Default deny — koi bhi aur collection explicitly allow nahi hai
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
